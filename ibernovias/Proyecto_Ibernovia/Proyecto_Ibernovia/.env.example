# Backend environment example (PowerShell / deployment)

# Server
SERVER_PORT=8080

# Database
DB_USERNAME=
DB_PASSWORD=

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT (minimo 64 caracteres)
APP_JWT_SECRET=

# Admin setup: mantenlo en false salvo alta inicial controlada
APP_ADMIN_SETUP_ENABLED=false
APP_ADMIN_SETUP_KEY=

# Firebase Admin
APP_FIREBASE_ENABLED=false
APP_FIREBASE_PROJECT_ID=ibernovia
# Usa una de estas opciones para credenciales del backend
APP_FIREBASE_CREDENTIALS_RESOURCE=
APP_FIREBASE_CREDENTIALS_JSON=
APP_FIREBASE_CREDENTIALS_BASE64=

# Auto-promocion admin solo si necesitas login social con emails concretos
ADMIN_EMAILS=admin@ibernovia.com

# SMTP Gmail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=info@ibernovia.es
SPRING_MAIL_PASSWORD=TU_APP_PASSWORD

# Contact destination
CONTACT_MAIL_TO=info@ibernovia.es

# Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
