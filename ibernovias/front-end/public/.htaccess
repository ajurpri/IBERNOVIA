# Fallback Routing para SPA (Vue Router)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compresión Gzip (mod_deflate) para acelerar descargas de archivos de texto
<IfModule mod_deflate.c>
  # Forzar compresión para tipos comunes
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xhtml+xml application/x-javascript image/svg+xml image/x-icon font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject
  
  # Limpieza de cabeceras para navegadores antiguos
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# Cabeceras de Caché (mod_expires) para optimizar carga repetida
<IfModule mod_expires.c>
  ExpiresEngine On
  ExpiresActive On

  # Por defecto cachear 1 semana
  ExpiresDefault "access plus 1 week"

  # index.html - NUNCA cachear para detectar nuevas compilaciones al instante
  ExpiresByType text/html "access plus 0 seconds"

  # Archivos estáticos con hash de Vite (JS/CSS) - Cachear 1 año (seguro por el hash en el nombre)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Fuentes - Cachear 1 año
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Imágenes y multimedia - Cachear 1 mes
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# Configuración adicional de Cache-Control para asegurar compatibilidad
<IfModule mod_headers.c>
  # index.html no se almacena en caché
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Archivos estáticos con hash (Vite)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fuentes e imágenes
  <FilesMatch "\.(gif|jpe?g|png|ico|webp|svg|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
